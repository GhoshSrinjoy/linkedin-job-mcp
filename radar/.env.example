# Copy to .env and fill in what you need. Every connector is optional and off until set here.

# --- LinkedIn --------------------------------------------------------------------------------
# Your linkedin-jobs-mcp REST API (github.com/GhoshSrinjoy/linkedin-job-mcp):
#   git clone https://github.com/GhoshSrinjoy/linkedin-job-mcp && cd linkedin-job-mcp
#   npm ci && npm run api            (listens on http://localhost:3000)
# It reads LinkedIn's public guest job search. LinkedIn's terms and robots.txt prohibit automated
# access without permission: keep volumes low and use the data for your own analysis.
LINKEDIN_JOBS_API=

# --- Bundesagentur für Arbeit (largest German source: about 1 million postings) -----------------
# 1 switches on the Jobsuche API. The BA's terms of use (§2a(3)) ban robots and automated
# "Datensammlung und -auswertung" without permission; see docs/ba-permission-request.md.
BA_JOBSUCHE=0

# --- Google for Jobs via JSearch (Indeed, StepStone, Glassdoor, XING, LinkedIn, employer sites) ---
# Key from https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch or openwebninja.com (free tier).
JSEARCH_API_KEY=
# JSEARCH_HOST=jsearch.p.rapidapi.com

# --- Adzuna (broad German coverage; free key at https://developer.adzuna.com/) ----------------
# Personal and academic research use is permitted; commercial analysis needs Adzuna's agreement.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- App settings ------------------------------------------------------------------------------
# GHOSTRADAR_DB=data/ghostradar.db
# GHOSTRADAR_MONITOR=1            # background re-checks of the watchlist
# GHOSTRADAR_MONITOR_HOURS=12
# GHOSTRADAR_NOMINATIM=1          # look up unknown city names on OpenStreetMap

# Public contracts won (EU procurement journal TED): documented open API, no key. On by default; 0 switches it off.
TED_CONTRACTS=1
